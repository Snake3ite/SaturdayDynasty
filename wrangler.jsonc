{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saturdaydynasty",
  "main": "worker.js",
  "compatibility_date": "2026-08-18",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "saturdaydynasty.dynastysportsstudios.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/s", "/s/", "/s/index.html"],
    "not_found_handling": "single-page-application"
  }
}
